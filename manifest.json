{
  "specVersion": "1.1",
  "type": "stdin",
  "name": "dp-it-giurisprudenza-convert",
  "version": "0.1.0",
  "description": "Converts grabbed case-law files (Corte costituzionale dumps, Cassazione Solr pages, CGT pages) into <stem>.plan.json load plans. Writes files only, no DB.",
  "author": "open-lex-it",
  "authentication": false,
  "actions": {
    "execute": {
      "description": "For each item read the grab output from dirIn and write <stem>.plan.json into dirOut. An item that cannot be converted is skipped and the run ends with system_error listing the failed keys.",
      "input": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "description": "the items to convert, as reported by the detect step",
            "items": {
              "type": "object",
              "properties": {
                "key": { "type": "string", "minLength": 1 },
                "meta": {
                  "type": "object",
                  "properties": { "kind": { "enum": ["cc", "cassazione", "cgt"] }, "itemId": { "type": "string" } },
                  "required": ["kind", "itemId"]
                }
              },
              "required": ["key", "meta"]
            }
          },
          "dirIn": { "type": "string", "description": "directory with the grab output" },
          "dirOut": { "type": "string", "description": "directory for the plan files" },
          "anni": { "type": "array", "items": { "type": "integer" }, "description": "Corte costituzionale sample filter: years" },
          "only": { "type": "array", "description": "Corte costituzionale sample filter: [{anno, numero}]" },
          "maxDocs": { "type": "integer", "description": "Cassazione sample filter" },
          "maxItems": { "type": "integer", "description": "CGT sample filter" }
        },
        "required": ["items", "dirIn", "dirOut"]
      },
      "output": {
        "type": "object",
        "description": "{ dirOut, converted: [{key, plan, meta}], metrics: {pronunce, massime, norme, cassazione, cgt, skipped} }"
      }
    },
    "terminate": {
      "description": "Stop and clean up.",
      "input": { "type": "object", "properties": {} }
    }
  },
  "execution": {
    "timeout": 3600,
    "memoryLimit": "1Gi",
    "cpuLimit": "1.0"
  }
}
